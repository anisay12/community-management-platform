# DEVELOPMENT values only. Never reuse them in staging or production.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=talan
POSTGRES_USER=talan
POSTGRES_PASSWORD=dev-only-password
DATABASE_URL=postgres://talan:dev-only-password@postgres:5432/talan
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://s3:8333
S3_BUCKET=talan-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=dev-only-s3
S3_SECRET_KEY=dev-only-s3-secret
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=communautes@localhost
METRICS_TOKEN=
AUDIT_IP_HASH_KEY=dev-only-audit-ip-hash-key
AUDIT_RETENTION_DAYS=365
ACCOUNT_ANONYMIZE_AFTER_DAYS=1095
NUM_PROXIES=0
LOG_LEVEL=INFO
AUTH_MODE=local
BREAK_GLASS_EMAIL=
# OpenID Connect, required when AUTH_MODE is mixed or sso_only.
OIDC_PROVIDER_NAME=entra
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
# Exact issuer of the ID tokens (required in SSO modes), for example:
# OIDC_OP_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OIDC_OP_ISSUER=
# Optional tenant pin (the ID token's tid claim); required with /common/ or
# /organizations/ endpoints, for example:
# OIDC_ALLOWED_TENANT_ID=00000000-0000-0000-0000-000000000000
OIDC_ALLOWED_TENANT_ID=
# Operational alert recipients: "Name <email>,other@example.com".
DJANGO_ADMINS=
SITE_URL=http://localhost:8000
DJANGO_ADMIN_PATH=django-admin/
# Optional: password for `manage.py create_dev_admin --password-from-env` (development only).
# DEV_ADMIN_PASSWORD=
